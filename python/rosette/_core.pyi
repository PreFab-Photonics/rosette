def read_gds(path: str) -> Library: ...
def write_gds(
    path: str,
    design: Cell | Library,
    cells: list[Cell] | None = None,
    quiet: bool = False,
    verbose: bool = False,
) -> None: ...
def to_json(design: Cell | Library, cells: list[Cell] | None = None) -> str: ...
def render_png(
    library: Library,
    *,
    bbox: BBox | None = None,
    cell: str | None = None,
    layers: list[tuple[int, int]] | None = None,
    width: int = 1024,
    height: int | None = None,
