    @property
    def padding(self) -> float: ...
    @property
    def contour_threshold(self) -> float: ...
    @property
    def keep_raster(self) -> bool: ...
    @property
    def max_area_deviation(self) -> float | None: ...
    @property
    def has_tolerances(self) -> bool: ...
    def set_layer_config(
        self,
        /,
        layer: Layer | int | tuple[int, int],
        sigma: float | None = None,
        max_area_deviation: float | None = None,
        severity: str | None = None,
    ) -> None: ...

class GaussianModel:
