      "help": "Build a design to GDS",
      "description": null,
      "epilog": null,
      "needs": "design",
      "arguments": [
        {
          "flags": [],
          "dest": "design",
          "positional": true,
          "required": true,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Design file (path or path:target)"
        },
        {
          "flags": [
            "-o",
            "--output"
          ],
          "dest": "output",
          "positional": false,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": "output",
          "help": "Output directory"
        },
        {
          "flags": [
            "-v",
            "--verbose"
          ],
          "dest": "verbose",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": false,
          "help": "Show detailed build output"
        },
        {
          "flags": [
            "--check"
          ],
          "dest": "check",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": false,
          "help": "Run DRC before building (warns but still writes GDS)"
        },
        {
          "flags": [
            "--config"
          ],
          "dest": "config",
          "positional": false,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Path to rosette.toml for --check (auto-detected if omitted)"
        }
      ]
    },
    "check": {
      "help": "Run all checks (DRC, design checks)",
      "description": "Run DRC and design checks (connectivity + bend radius); add --include-dfm to also run DFM prediction.",
      "epilog": "With --json, `check` emits a single JSON object on stdout (schema 1); decorative output is suppressed so stdout stays parseable. Read `passed` directly; each violation carries a `bbox` in microns (same coordinate space as `rosette shot`) locating the problem. Exit codes: 0 = passed, 1 = violations/error, 2 = bad usage. These are stable; branch on the exit code, not on the printed text.",
      "needs": "design",
      "arguments": [
        {
          "flags": [],
          "dest": "design",
          "positional": true,
          "required": true,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Design file (path or path:target)"
