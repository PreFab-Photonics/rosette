          "dest": "config",
          "positional": false,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Path to rosette.toml (auto-detected if omitted)"
        },
        {
          "flags": [
            "--include-dfm"
          ],
          "dest": "include_dfm",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": false,
          "help": "Also run DFM prediction (requires [dfm] section in rosette.toml)"
        },
        {
          "flags": [
            "-v",
            "--verbose"
          ],
          "dest": "verbose",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": false,
          "help": "Show detailed output"
        },
        {
          "flags": [
            "--json"
          ],
          "dest": "json",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": false,
          "help": "Emit a single machine-readable JSON object to stdout (schema 1)"
        }
      ]
