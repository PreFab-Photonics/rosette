{
  "schema": 1,
  "prog": "rosette",
  "description": "Photonic layout tool for creating and building GDS designs",
  "json_schema": 1,
  "package_version": "0.5.0",
  "arguments": [
    {
      "flags": [
        "-V",
        "--version"
      ],
      "dest": "version",
      "positional": false,
      "required": false,
      "takes_value": false,
      "metavar": null,
      "choices": null,
      "default": null,
      "help": "show program's version number and exit"
    }
  ],
  "commands": {
    "init": {
      "help": "Initialize rosette in the current dir or a new project directory",
      "description": null,
      "epilog": null,
      "needs": "nothing",
      "arguments": [
        {
          "flags": [],
          "dest": "path",
          "positional": true,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Directory to create the project in (created if needed). Defaults to current dir."
        },
        {
          "flags": [
            "-n",
            "--name"
          ],
          "dest": "name",
          "positional": false,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Project name (defaults to the project directory name). Interactive if omitted."
        },
        {
          "flags": [
            "-t",
            "--template"
          ],
          "dest": "template",
          "positional": false,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "Project template to use (blank, generic). Interactive if omitted."
        },
        {
          "flags": [
            "--tool"
          ],
          "dest": "tool",
          "positional": false,
          "required": false,
          "takes_value": true,
          "metavar": null,
          "choices": null,
          "default": null,
          "help": "AI tool(s) to configure, comma-separated (e.g. 'agents', 'claude', 'agents,claude', or 'none'). Aliases like 'opencode'/'codex'/'cursor' map to the AGENTS.md standard. Interactive if omitted."
        },
        {
          "flags": [
            "-y",
            "--yes"
          ],
          "dest": "yes",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": false,
          "help": "Skip confirmation when bootstrapping a uv project (uv init + uv add librosette)."
        },
        {
          "flags": [
            "--no-git"
          ],
          "dest": "git",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": true,
          "help": "Don't run `git init` when bootstrapping a new project."
        },
        {
          "flags": [
            "--no-install"
          ],
          "dest": "install",
          "positional": false,
          "required": false,
          "takes_value": false,
          "metavar": null,
          "choices": null,
          "default": true,
          "help": "Dev only: skip `uv add librosette` when bootstrapping, so the project's venv doesn't shadow a globally-installed (e.g. working-copy) rosette. `uv run rosette` then uses the rosette on PATH. The project won't declare librosette as a dependency or be able to `import rosette`."
        }
      ]
    },
    "update": {
      "help": "Update generated project context",
      "description": null,
      "epilog": null,
      "needs": "nothing",
      "arguments": []
    },
    "cli-manifest": {
      "help": "Print the machine-readable CLI manifest (same as .rosette/cli.json)",
      "description": "Print the CLI command manifest as JSON to stdout. This is the same object written to .rosette/cli.json by `rosette init`/`update`: a discoverable contract of every command, its flags, exit codes, and the --json schema version. Derived from the argparse parser, so it never drifts from the real CLI.",
      "epilog": null,
      "needs": "nothing",
      "arguments": []
    },
